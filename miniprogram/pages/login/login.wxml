<view class="card">
  <view class="title">家族族谱</view>
  <view class="muted" style="margin-top:12rpx;">微信 OpenID 或登录名登录，共用同一套族谱服务。</view>
</view>

<view class="card" wx:if="{{wechatEnabled || allowDevMock}}">
  <button class="btn" bindtap="onWxLogin">微信登录</button>
  <view class="muted" wx:if="{{allowDevMock && !wechatEnabled}}" style="margin-top:12rpx;">当前为开发模拟（未配 AppId）。</view>
</view>

<view class="card">
  <view class="title">登录名登录</view>
  <input class="input" placeholder="登录名（手机号或拼音）" value="{{idCard}}" bindinput="onId" />
  <input class="input" password placeholder="密码" value="{{password}}" bindinput="onPwd" />
  <button class="btn" bindtap="onIdLogin">登录</button>
</view>

<view class="card">
  <view class="title">首次注册</view>
  <input class="input" placeholder="登录名（≥6位字母或数字）" value="{{regId}}" bindinput="onRegId" />
  <input class="input" placeholder="姓名" value="{{realName}}" bindinput="onName" />
  <input class="input" password placeholder="密码至少6位" value="{{regPwd}}" bindinput="onRegPwd" />
  <input class="input" password placeholder="再输一次密码" value="{{regPwd2}}" bindinput="onRegPwd2" />
  <button class="btn btn-ghost" bindtap="onRegister">注册并登录</button>
</view>
