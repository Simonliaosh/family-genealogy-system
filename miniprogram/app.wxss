page { background: #f4f5f7; color: #222; font-size: 28rpx; }
.card { background: #fff; margin: 24rpx; padding: 28rpx; border-radius: 12rpx; }
.btn { background: #2c3e50; color: #fff; text-align: center; padding: 20rpx; border-radius: 8rpx; margin-top: 20rpx; }
.btn-ghost { background: #fff; color: #2c3e50; border: 1px solid #2c3e50; }
.muted { color: #888; font-size: 24rpx; }
.input { border: 1px solid #ddd; border-radius: 8rpx; padding: 16rpx 20rpx; margin-top: 16rpx; }
.row { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 0; border-bottom: 1px solid #f0f0f0; }
.title { font-size: 32rpx; font-weight: 600; }
