@model FamilyTree.Models.ViewModels.AccountIdentitySelectViewModel
@{
    ViewData["Title"] = "选择登录身份";
}

<div class="card mx-auto" style="max-width:520px;">
    <div class="card-header">
        <h5 class="mb-0">选择登录身份</h5>
    </div>
    <div class="card-body">
        <p class="mb-2">账号：<strong>@Model.LoginId</strong>（@Model.RealName）</p>
        <p class="text-muted small mb-3">该账号存在多个身份，请选择本次登录身份。</p>
        <form asp-action="SelectIdentity" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <div class="mb-3">
                <label asp-for="SelectedIdentityType" class="form-label">登录身份</label>
                <select asp-for="SelectedIdentityType" class="form-select">
                    @foreach (var o in Model.IdentityOptions)
                    {
                        if (o.Value == Model.SelectedIdentityType) { <option value="@o.Value" selected>@o.Text</option> } else { <option value="@o.Value">@o.Text</option> }
                    }
                </select>
                <span asp-validation-for="SelectedIdentityType" class="text-danger"></span>
            </div>
            <div class="d-flex justify-content-center gap-2">
                <button type="submit" class="btn btn-primary">进入系统</button>
                <a asp-action="Logout" class="btn btn-secondary">退出</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

