@model FamilyTree.Models.ViewModels.HrLeaveFormVm
@{
    ViewData["Title"] = "请假申请";
    var types = ViewBag.LeaveTypes as List<(string Value, string Text)> ?? new();
    var result = ViewBag.SubmitResult as FamilyTree.Models.ViewModels.HrLeaveSubmitResultVm;
}

<div class="card">
    <div class="card-header"><h5 class="mb-0">请假申请</h5></div>
    <div class="card-body">
        @if (result != null && !result.Success)
        {
            <div class="alert alert-danger">@result.Message</div>
        }
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3 row">
                <label class="col-md-2 col-form-label text-md-end">假别</label>
                <div class="col-md-4">
                    <select asp-for="LeaveType" class="form-select">
                        @foreach (var t in types)
                        {
                            <option value="@t.Value">@t.Text</option>
                        }
                    </select>
                    <span asp-validation-for="LeaveType" class="text-danger"></span>
                </div>
            </div>
            <div class="mb-3 row">
                <label class="col-md-2 col-form-label text-md-end">开始日期</label>
                <div class="col-md-4">
                    <input asp-for="StartDate" type="date" class="form-control" />
                    <span asp-validation-for="StartDate" class="text-danger"></span>
                </div>
            </div>
            <div class="mb-3 row">
                <label class="col-md-2 col-form-label text-md-end">结束日期</label>
                <div class="col-md-4">
                    <input asp-for="EndDate" type="date" class="form-control" />
                    <span asp-validation-for="EndDate" class="text-danger"></span>
                </div>
            </div>
            <div class="mb-3 row">
                <label class="col-md-2 col-form-label text-md-end">天数</label>
                <div class="col-md-4">
                    <input asp-for="Days" class="form-control" />
                    <span asp-validation-for="Days" class="text-danger"></span>
                </div>
            </div>
            <div class="mb-3 row">
                <label class="col-md-2 col-form-label text-md-end">事由</label>
                <div class="col-md-6">
                    <textarea asp-for="Reason" class="form-control" rows="3"></textarea>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 offset-md-2">
                    <button type="submit" class="btn btn-primary">提交并发起流程</button>
                    <a class="btn btn-secondary" asp-action="Index">返回</a>
                </div>
            </div>
        </form>
        <p class="small text-muted mt-3 mb-0">提交后将发布事件 <code>FRAME.LEAVE.SUBMIT</code>，并为审批职责生成待办。</p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var start = document.querySelector('[name="StartDate"]');
            var end = document.querySelector('[name="EndDate"]');
            var days = document.querySelector('[name="Days"]');
            if (!start || !end || !days) return;
            function syncDays() {
                if (!start.value || !end.value) return;
                var sd = new Date(start.value + 'T00:00:00');
                var ed = new Date(end.value + 'T00:00:00');
                if (ed < sd) return;
                var span = Math.floor((ed - sd) / 86400000) + 1;
                days.value = span;
            }
            start.addEventListener('change', syncDays);
            end.addEventListener('change', syncDays);
        })();
    </script>
}
