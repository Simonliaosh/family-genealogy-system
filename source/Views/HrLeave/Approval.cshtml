@model IReadOnlyList<FamilyTree.Models.ViewModels.HrLeaveListRowVm>
@{
    ViewData["Title"] = "请假审批";
}

<div class="card">
    <div class="card-header"><h5 class="mb-0">请假审批（待处理）</h5></div>
    <div class="card-body p-0">
        @if (TempData["HrLeaveMessage"] is string okMsg)
        {
            <div class="alert alert-success m-3 mb-0">@okMsg</div>
        }
        @if (TempData["HrLeaveError"] is string errMsg)
        {
            <div class="alert alert-danger m-3 mb-0">@errMsg</div>
        }
        <table class="table table-striped table-hover mb-0">
            <thead>
            <tr>
                <th>单号</th>
                <th>申请人</th>
                <th>假别</th>
                <th>区间</th>
                <th class="text-end">天数</th>
                <th>提交时间</th>
                <th class="text-center">操作</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td><a asp-action="Details" asp-route-id="@r.DataId">@r.RequestNo</a></td>
                    <td>@(r.ApplicantName ?? "-")</td>
                    <td>@r.LeaveType</td>
                    <td>@r.StartDate.ToString("yyyy-MM-dd") ~ @r.EndDate.ToString("yyyy-MM-dd")</td>
                    <td class="text-end">@r.Days</td>
                    <td>@r.CreateDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td class="text-center" style="min-width:200px">
                        <form asp-action="Approve" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@r.DataId" />
                            <input type="text" name="remark" class="form-control form-control-sm mb-1" placeholder="审批意见" />
                            <button type="submit" name="action" value="approve" class="btn btn-sm btn-success">同意</button>
                            <button type="submit" name="action" value="reject" class="btn btn-sm btn-outline-danger ms-1">驳回</button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="7" class="text-center text-muted py-4">暂无待审批单据</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
