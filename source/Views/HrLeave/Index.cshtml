@model IReadOnlyList<FamilyTree.Models.ViewModels.HrLeaveListRowVm>
@{
    ViewData["Title"] = "我的请假";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">我的请假</h5>
        <a class="btn btn-primary btn-sm" asp-action="Create">新建申请</a>
    </div>
    <div class="card-body p-0">
        @if (TempData["HrLeaveMessage"] is string okMsg)
        {
            <div class="alert alert-success m-3 mb-0">@okMsg</div>
        }
        <table class="table table-striped table-hover mb-0">
            <thead>
            <tr>
                <th>单号</th>
                <th>假别</th>
                <th>开始</th>
                <th>结束</th>
                <th class="text-end">天数</th>
                <th>状态</th>
                <th>提交时间</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.RequestNo</td>
                    <td>@r.LeaveType</td>
                    <td>@r.StartDate.ToString("yyyy-MM-dd")</td>
                    <td>@r.EndDate.ToString("yyyy-MM-dd")</td>
                    <td class="text-end">@r.Days</td>
                    <td>@r.StatusText</td>
                    <td>@r.CreateDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td><a asp-action="Details" asp-route-id="@r.DataId">详情</a></td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="8" class="text-center text-muted py-4">暂无记录</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
