@model FamilyTree.Models.ViewModels.DashPosPermIndexVm
@{
    ViewData["Title"] = "岗位指标权限";
    var canUp = ViewBag.CanUpdate == true;
}

<div class="card polist-wrap">
    <div class="card-header"><h5 class="mb-0">岗位指标权限</h5></div>
    <div class="card-body py-2">
        <form id="f-pos-select" asp-action="Index" method="get" class="polist-filter pm-filter-grid mb-3">
            <div class="d-flex align-items-center gap-1">
                <label class="polist-filter-lbl mb-0">岗位</label>
                <select name="posId" class="form-select form-select-sm" style="min-width:16rem;" onchange="this.form.submit()">
                    @foreach (var o in Model.PosOptions)
                    {
                        if (o.PosId == Model.PosId) { <option value="@o.PosId" selected>@o.PostCName</option> } else { <option value="@o.PosId">@o.PostCName</option> }
                    }
                </select>
            </div>
        </form>

        @if (Model.PosId > 0)
        {
            <form id="f-main" asp-action="Save" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="PosId" value="@Model.PosId" />

                <div class="table-responsive">
                    <table class="table table-polist table-sm align-middle">
                        <thead>
                        <tr>
                            <th class="text-center" style="width:3rem;">
                                <input type="checkbox" id="chk-all-ind" class="align-middle" @(canUp ? null : "disabled") />
                            </th>
                            <th class="text-center">指标编码</th>
                            <th class="text-center">指标名称</th>
                            <th class="text-center">应用</th>
                            <th class="text-center">图表类型</th>
                            <th class="text-center">数据来源</th>
                            <th class="text-center">状态</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var x in Model.Indicators)
                        {
                            var granted = Model.GrantedIndicatorIds.Contains(x.DataId);
                            <tr>
                                <td class="text-center">
                                    <input type="checkbox" name="IndicatorIds" value="@x.DataId" class="ind-row-chk align-middle" @(granted ? "checked" : null) @(canUp ? null : "disabled") />
                                </td>
                                <td class="text-center">@x.IndicatorCode</td>
                                <td class="text-center">@x.IndicatorName</td>
                                <td class="text-center">@x.AppCode</td>
                                <td class="text-center">@x.ChartTypeName</td>
                                <td class="text-center">@x.DataSource</td>
                                <td class="text-center">@x.BStatus</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>

                @if (canUp)
                {
                    <div class="mt-3 d-flex justify-content-center">
                        <button type="submit" class="btn btn-primary">保存</button>
                    </div>
                }
            </form>
        }
        else
        {
            <p class="text-muted mb-0">暂无可用岗位。</p>
        }
    </div>
</div>

<script>
    document.getElementById('chk-all-ind')?.addEventListener('change', function () {
        document.querySelectorAll('.ind-row-chk').forEach(c => c.checked = this.checked);
    });
</script>
