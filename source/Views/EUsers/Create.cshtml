@model FamilyTree.Models.ViewModels.EUsersFormVm
@{
    ViewData["Title"] = "用户账号录入";
}
<div class="card">
    <div class="card-header"><h5 class="mb-0">用户账号录入</h5></div>
    <div class="card-body">
        <form asp-action="Create" method="post" class="pm-form-wrap">
            @Html.AntiForgeryToken()
            <partial name="_Form" model="Model" />
            <div class="text-center py-2 d-inline-flex align-items-center justify-content-center" style="gap:.5rem;width:100%;">
                <button type="submit" class="btn btn-primary btn-sm" name="selectNo" value="1">保存/继续</button>
                <button type="submit" class="btn btn-primary btn-sm" name="selectNo" value="0">保存/退出</button>
                <a asp-action="Index" class="btn btn-secondary btn-sm">关闭/退出</a>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}

