@model IEnumerable<FamilyTree.Models.EUser>
@using FamilyTree.Helpers
@{
    ViewData["Title"] = "用户账号管理";
    var canCr = ViewBag.CanCreate == true;
    var canUp = ViewBag.CanUpdate == true;
    var canDel = ViewBag.CanDelete == true;
    var userType1 = (string?)ViewBag.UserType1 ?? "全部";
    var isEnabled1 = (string?)ViewBag.IsEnabled1 ?? "全部";
    var isLocked1 = (string?)ViewBag.IsLocked1 ?? "全部";
    var bStatus1 = (string?)ViewBag.BStatus1 ?? "全部";
    var searchField = (string?)ViewBag.SearchField ?? "LoginId";
    var searchContent = (string?)ViewBag.SearchContent ?? "";
    var intPage = (int)(ViewBag.IntPage ?? 1);
    var pageShowNum = (int)(ViewBag.PageShowNum ?? 16);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalRecords = (int)(ViewBag.TotalRecords ?? 0);
    var selectField = (string?)ViewBag.SelectField ?? "-";
    var selectFieldArrow = (string?)ViewBag.SelectFieldArrow ?? "0";
    var userTypeOptions = ViewBag.UserTypeOptions as List<(string Value, string Text)> ?? new();
    var userTypeMap = ViewBag.UserTypeMap as IReadOnlyDictionary<string, string>;
    var isEnabledOptions = ViewBag.IsEnabledOptions as List<(string Value, string Text)> ?? new();
    var isLockedOptions = ViewBag.IsLockedOptions as List<(string Value, string Text)> ?? new();
    var bStatusOptions = ViewBag.BStatusOptions as List<(string Value, string Text)> ?? new();
    string A(string f, string d) => string.Equals(selectField, f, StringComparison.OrdinalIgnoreCase) && string.Equals(selectFieldArrow, d, StringComparison.Ordinal) ? "text-dark" : "text-secondary";
    var polistPr = PolistReturnToken.Encode(new Dictionary<string, string?>
    {
        ["intPage"] = intPage.ToString(),
        ["pageShowNum"] = pageShowNum.ToString(),
        ["selectField"] = selectField,
        ["selectFieldArrow"] = selectFieldArrow,
        ["searchField"] = searchField,
        ["searchContent"] = searchContent,
        ["userType1"] = userType1,
        ["isEnabled1"] = isEnabled1,
        ["isLocked1"] = isLocked1,
        ["bStatus1"] = bStatus1,
    });
}
<div class="card polist-wrap">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">用户账号管理</h5>
    </div>
    <div class="card-body">
        <form id="f-main" asp-action="Index" method="post">
            <input type="hidden" name="selectField" id="sf" value="@selectField" />
            <input type="hidden" name="selectFieldArrow" id="sa" value="@selectFieldArrow" />
            <div class="mb-2 polist-filter pm-filter-grid">
                <div class="d-flex align-items-center gap-1">
                    <span class="polist-filter-lbl">用户类型</span>
                    <select name="userType1" class="form-select form-select-sm" onchange="goFilter();">
                        @foreach (var x in userTypeOptions)
                        {
                            if (string.Equals(x.Value, userType1, StringComparison.OrdinalIgnoreCase))
                            { <option value="@x.Value" selected>@x.Text</option> }
                            else
                            { <option value="@x.Value">@x.Text</option> }
                        }
                    </select>
                </div>
                <div class="d-flex align-items-center gap-1">
                    <span class="polist-filter-lbl">启用状态</span>
                    <select name="isEnabled1" class="form-select form-select-sm" onchange="goFilter();">
                        @foreach (var o in isEnabledOptions)
                        {
                            if (string.Equals(o.Value, isEnabled1, StringComparison.OrdinalIgnoreCase))
                            { <option value="@o.Value" selected>@o.Text</option> }
                            else
                            { <option value="@o.Value">@o.Text</option> }
                        }
                    </select>
                </div>
                <div class="d-flex align-items-center gap-1">
                    <span class="polist-filter-lbl">锁定状态</span>
                    <select name="isLocked1" class="form-select form-select-sm" onchange="goFilter();">
                        @foreach (var o in isLockedOptions)
                        {
                            if (string.Equals(o.Value, isLocked1, StringComparison.OrdinalIgnoreCase))
                            { <option value="@o.Value" selected>@o.Text</option> }
                            else
                            { <option value="@o.Value">@o.Text</option> }
                        }
                    </select>
                </div>
                <div class="d-flex align-items-center gap-1">
                    <span class="polist-filter-lbl">业务状态</span>
                    <select name="bStatus1" class="form-select form-select-sm" onchange="goFilter();">
                        @foreach (var x in bStatusOptions)
                        {
                            if (string.Equals(x.Value, bStatus1, StringComparison.OrdinalIgnoreCase))
                            { <option value="@x.Value" selected>@x.Text</option> }
                            else
                            { <option value="@x.Value">@x.Text</option> }
                        }
                    </select>
                </div>
            </div>

            @if (canDel)
            {
                @Html.AntiForgeryToken()
            }

            <div class="table-responsive">
                <table class="table table-hover table-sm align-middle">
                    <thead>
                        <tr>
                            <th class="text-center">
                                <span class="d-inline-flex align-items-center">账号
                                    <span class="d-inline-flex flex-column ms-0" style="font-size:.72em;line-height:.78;margin-left:.08rem;">
                                        <a class="@A("LoginId","0") text-decoration-none" href="javascript:doSort('LoginId','0');">▲</a>
                                        <a class="@A("LoginId","1") text-decoration-none" href="javascript:doSort('LoginId','1');">▼</a>
                                    </span>
                                </span>
                            </th>
                            <th class="text-center">
                                <span class="d-inline-flex align-items-center">姓名
                                    <span class="d-inline-flex flex-column ms-0" style="font-size:.72em;line-height:.78;margin-left:.08rem;">
                                        <a class="@A("RealName","0") text-decoration-none" href="javascript:doSort('RealName','0');">▲</a>
                                        <a class="@A("RealName","1") text-decoration-none" href="javascript:doSort('RealName','1');">▼</a>
                                    </span>
                                </span>
                            </th>
                            <th class="text-center">
                                <span class="d-inline-flex align-items-center">用户类型
                                    <span class="d-inline-flex flex-column ms-0" style="font-size:.72em;line-height:.78;margin-left:.08rem;">
                                        <a class="@A("UserType","0") text-decoration-none" href="javascript:doSort('UserType','0');">▲</a>
                                        <a class="@A("UserType","1") text-decoration-none" href="javascript:doSort('UserType','1');">▼</a>
                                    </span>
                                </span>
                            </th>
                            <th class="text-center">启用状态</th>
                            <th class="text-center eu-col-last-login">
                                <span class="d-inline-flex align-items-center">最后登录时间
                                    <span class="d-inline-flex flex-column ms-0" style="font-size:.72em;line-height:.78;margin-left:.08rem;">
                                        <a class="@A("LastLoginTime","0") text-decoration-none" href="javascript:doSort('LastLoginTime','0');">▲</a>
                                        <a class="@A("LastLoginTime","1") text-decoration-none" href="javascript:doSort('LastLoginTime','1');">▼</a>
                                    </span>
                                </span>
                            </th>
                            <th class="text-center">
                                <span class="d-inline-flex align-items-center">业务状态
                                    <span class="d-inline-flex flex-column ms-0" style="font-size:.72em;line-height:.78;margin-left:.08rem;">
                                        <a class="@A("BStatus","0") text-decoration-none" href="javascript:doSort('BStatus','0');">▲</a>
                                        <a class="@A("BStatus","1") text-decoration-none" href="javascript:doSort('BStatus','1');">▼</a>
                                    </span>
                                </span>
                            </th>
                            @if (canUp)
                            {
                                <th class="text-end pm-sticky-col pm-col-detail pm-op-col">
                                    @if (canCr)
                                    {
                                        <a class="btn btn-sm btn-outline-primary pm-op-btn" asp-action="Create">添加</a>
                                    }
                                </th>
                            }
                            @if (canDel)
                            {
                                <th class="text-end pm-sticky-col pm-col-del pm-op-col">
                                    <button type="submit" formaction="@Url.Action("DeleteBatch")" class="btn btn-sm btn-outline-danger pm-op-btn" onclick="return confirm('确定要删除吗？\n注意：删除后不能恢复！');">删除</button>
                                </th>
                                <th class="text-end pm-sticky-col pm-col-sel pm-op-col"><input type="checkbox" id="chk-all-pm" title="全选" class="align-middle pm-op-chk" /></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var x in Model)
                        {
                            <tr>
                                <td class="text-center">@x.LoginId</td>
                                <td class="text-center">@x.RealName</td>
                                <td class="text-center">@EUserCodeMaps.ToUserTypeText(x.UserType, userTypeMap)</td>
                                <td class="text-center">@EUserCodeMaps.ToText(x.IsEnabled ? "1" : "0", "IsEnabled")</td>
                                <td class="text-center eu-col-last-login">@(x.LastLoginTime?.ToString("yyyy-MM-dd HH:mm:ss") ?? "-")</td>
                                <td class="text-center">@EUserCodeMaps.ToText(x.BStatus, "BStatus")</td>
                                @if (canUp)
                                {
                                    <td class="text-end pm-sticky-col pm-col-detail pm-op-col"><a class="btn btn-sm btn-outline-primary pm-op-btn" asp-action="Edit" asp-route-id="@x.DataId" asp-route-polistRt="@polistPr">详情</a></td>
                                }
                                @if (canDel)
                                {
                                    <td class="text-end pm-sticky-col pm-col-del pm-op-col"><button type="submit" formaction="@Url.Action("Delete")" name="id" value="@x.DataId" class="btn btn-sm btn-outline-danger pm-op-btn" onclick="return confirm('确定要删除吗？\n注意：删除后不能恢复！');">删除</button></td>
                                    <td class="text-end pm-sticky-col pm-col-sel pm-op-col"><input type="checkbox" name="id" value="@x.DataId" class="pm-row-chk align-middle pm-op-chk" /></td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="mt-1 mb-2" style="border-top:1px solid #d6dbe1;"></div>

            <div class="mt-2 d-flex align-items-center justify-content-center flex-wrap pm-pager" style="column-gap:.25rem;row-gap:.35rem;font-size:.88rem;">
                <div class="pm-pager-group">
                    <select name="searchField" class="form-select form-select-sm" style="width:16ch;font-size:.8rem;min-height:calc(1.8125rem + 2px);">
                        @foreach (var o in new[] { ("LoginId", "账号"), ("RealName", "姓名"), ("UserType", "用户类型") })
                        {
                            if (string.Equals(searchField, o.Item1, StringComparison.OrdinalIgnoreCase)) { <option value="@o.Item1" selected>@o.Item2</option> } else { <option value="@o.Item1">@o.Item2</option> }
                        }
                    </select>
                    <span>包含内容</span>
                    <input name="searchContent" value="@searchContent" class="form-control form-control-sm" style="width:12ch;font-size:.8rem;padding:0 .25rem;" />
                    <button type="submit" class="btn btn-sm btn-outline-primary" style="font-size:.88rem;padding:.08rem .4rem;" onclick="setPage(1);">查询</button>
                </div>
                <div class="pm-pager-group">
                    <span>第 @(intPage) 页/总 @(totalPages) 页 总 @(totalRecords) 条</span>
                    <button type="submit" class="btn btn-sm btn-outline-secondary pm-pager-btn" style="font-size:.88rem;padding:.08rem .4rem;" onclick="setPage(1);" @(intPage <= 1 ? "disabled" : null)>首页</button>
                    <button type="submit" class="btn btn-sm btn-outline-secondary pm-pager-btn" style="font-size:.88rem;padding:.08rem .4rem;" onclick="setPage(@(intPage - 1));" @(intPage <= 1 ? "disabled" : null)>上页</button>
                    <button type="submit" class="btn btn-sm btn-outline-secondary pm-pager-btn" style="font-size:.88rem;padding:.08rem .4rem;" onclick="setPage(@(intPage + 1));" @(intPage >= totalPages ? "disabled" : null)>下页</button>
                    <button type="submit" class="btn btn-sm btn-outline-secondary pm-pager-btn" style="font-size:.88rem;padding:.08rem .4rem;" onclick="setPage(@(totalPages));" @(intPage >= totalPages ? "disabled" : null)>尾页</button>
                </div>
                <div class="pm-pager-group">
                    <span>每页显示</span>
                    <input name="pageShowNum" value="@(pageShowNum)" class="form-control form-control-sm" style="width:4ch;height:1.2rem;font-size:.8rem;padding:0 .2rem;" />
                    <span>条</span>
                    <span>转到第</span>
                    <input name="intPage" id="intPageInput" value="@(intPage)" class="form-control form-control-sm" style="width:4ch;height:1.2rem;font-size:.8rem;padding:0 .2rem;" />
                    <span>页</span>
                    <button type="submit" class="btn btn-sm btn-primary" style="font-size:.88rem;padding:.08rem .4rem;">Go</button>
                </div>
            </div>
        </form>
    </div>
</div>
<script>
    function setPage(p) {
        document.getElementById('intPageInput').value = p;
    }
    function doSort(f, a) {
        document.getElementById('sf').value = f;
        document.getElementById('sa').value = a;
        document.getElementById('f-main').submit();
    }
    function goFilter() {
        setPage(1);
        document.getElementById('f-main').submit();
    }
    document.getElementById('chk-all-pm')?.addEventListener('change', function () {
        document.querySelectorAll('.pm-row-chk').forEach(c => { c.checked = this.checked; });
    });
</script>

<style>
    .pm-sticky-col{position:sticky;background:#fff;z-index:4;}
    thead .pm-sticky-col{background:#f8f9fa;z-index:5;}
    .eu-col-last-login{white-space:nowrap;min-width:10.5rem;}
    .pm-op-col{padding-left:.2rem!important;padding-right:.2rem!important;white-space:nowrap;text-align:right!important;}
    .pm-col-sel{right:0;width:1.65rem;min-width:1.65rem;}
    .pm-col-del{right:1.65rem;width:2.7rem;min-width:2.7rem;}
    .pm-col-detail{right:4.35rem;width:2.9rem;min-width:2.9rem;}
    .pm-op-btn{font-size:.72rem!important;line-height:1.15!important;padding:.05rem .2rem!important;min-height:1.2rem;height:1.2rem;display:inline-flex;align-items:center;justify-content:center;}
    .pm-op-chk{margin:0;transform:scale(.92);}
    @@media (max-width:576px){
        .eu-col-last-login{min-width:8.8rem;font-size:.78rem;}
        .pm-col-sel{width:1.5rem;min-width:1.5rem;}
        .pm-col-del{right:1.5rem;width:2.45rem;min-width:2.45rem;}
        .pm-col-detail{right:3.95rem;width:2.65rem;min-width:2.65rem;}
        .pm-op-btn{font-size:.68rem!important;padding:.03rem .14rem!important;min-height:1.1rem;height:1.1rem;}
    }
</style>

