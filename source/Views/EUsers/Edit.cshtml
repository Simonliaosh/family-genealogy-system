@model FamilyTree.Models.ViewModels.EUsersFormVm
@using FamilyTree.Helpers
@{
    ViewData["Title"] = "用户账号维护";
}
<div class="card">
    <div class="card-header"><h5 class="mb-0">用户账号维护</h5></div>
    <div class="card-body">
        <form asp-action="Edit" method="post" class="pm-form-wrap">
            @Html.AntiForgeryToken()
            @Html.PolistReturnHidden(ViewBag.PolistRt as string)
            <input asp-for="DataId" type="hidden" />
            <partial name="_Form" model="Model" />
            <div class="text-center py-2 d-inline-flex align-items-center justify-content-center" style="gap:.5rem;width:100%;">
                <button type="submit" class="btn btn-primary btn-sm" name="selectNo" value="1">保存/继续</button>
                <button type="submit" class="btn btn-primary btn-sm" name="selectNo" value="0">保存/退出</button>
                <a class="btn btn-secondary btn-sm" href="@Url.Action("Index", PolistReturnToken.IndexRoute(ViewBag.PolistRt as string))">关闭/退出</a>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}

