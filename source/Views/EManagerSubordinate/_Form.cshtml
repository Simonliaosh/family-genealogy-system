@model FamilyTree.Models.ViewModels.EManagerSubordinateFormVm
@{
    var userOptions = ViewBag.UserOptions as List<(string Value, string Text)> ?? new();
    var deptOptions = ViewBag.DeptOptions as List<(string Value, string Text)> ?? new();
    var postOptions = ViewBag.PostOptions as List<(string Value, string Text)> ?? new();
    var bStatusOptions = ViewBag.BStatusOptions as List<(string Value, string Text)> ?? new();
}

<input type="hidden" asp-for="DataId" />

<div class="mb-3 row">
    <label class="col-md-2 col-form-label text-md-end">上级用户</label>
    <div class="col-md-8">
        <select asp-for="ManagerUserId" class="form-select">
            <option value="0">请选择</option>
            @foreach (var o in userOptions)
            {
                if (o.Value == Model.ManagerUserId.ToString()) { <option value="@o.Value" selected>@o.Text</option> } else { <option value="@o.Value">@o.Text</option> }
            }
        </select>
        <span asp-validation-for="ManagerUserId" class="text-danger"></span>
    </div>
</div>
<div class="mb-3 row">
    <label class="col-md-2 col-form-label text-md-end">下级用户</label>
    <div class="col-md-8">
        <select asp-for="SubUserId" class="form-select">
            <option value="0">请选择</option>
            @foreach (var o in userOptions)
            {
                if (o.Value == Model.SubUserId.ToString()) { <option value="@o.Value" selected>@o.Text</option> } else { <option value="@o.Value">@o.Text</option> }
            }
        </select>
        <span asp-validation-for="SubUserId" class="text-danger"></span>
    </div>
</div>
<div class="mb-3 row">
    <label class="col-md-2 col-form-label text-md-end">部门</label>
    <div class="col-md-8">
        <select asp-for="DeptId" class="form-select">
            @foreach (var o in deptOptions)
            {
                if (o.Value == Model.DeptId.ToString()) { <option value="@o.Value" selected>@o.Text</option> } else { <option value="@o.Value">@o.Text</option> }
            }
        </select>
        <span asp-validation-for="DeptId" class="text-danger"></span>
    </div>
</div>
<div class="mb-3 row">
    <label class="col-md-2 col-form-label text-md-end">上级岗位</label>
    <div class="col-md-8">
        <select asp-for="ManagerPostId" class="form-select">
            @foreach (var o in postOptions)
            {
                if (o.Value == Model.ManagerPostId.ToString()) { <option value="@o.Value" selected>@o.Text</option> } else { <option value="@o.Value">@o.Text</option> }
            }
        </select>
        <span asp-validation-for="ManagerPostId" class="text-danger"></span>
    </div>
</div>
<div class="mb-3 row">
    <label class="col-md-2 col-form-label text-md-end">下级岗位</label>
    <div class="col-md-8">
        <select asp-for="SubPostId" class="form-select">
            @foreach (var o in postOptions)
            {
                if (o.Value == Model.SubPostId.ToString()) { <option value="@o.Value" selected>@o.Text</option> } else { <option value="@o.Value">@o.Text</option> }
            }
        </select>
        <span asp-validation-for="SubPostId" class="text-danger"></span>
    </div>
</div>
<div class="mb-3 row">
    <label class="col-md-2 col-form-label text-md-end">显示顺序</label>
    <div class="col-md-8">
        <input asp-for="DispSeq" type="number" min="0" class="form-control" />
        <span asp-validation-for="DispSeq" class="text-danger"></span>
    </div>
</div>
<div class="mb-3 row">
    <label class="col-md-2 col-form-label text-md-end">状态</label>
    <div class="col-md-8">
        <select asp-for="BStatus" class="form-select">
            @foreach (var o in bStatusOptions)
            {
                if (o.Value == Model.BStatus) { <option value="@o.Value" selected>@o.Text</option> } else { <option value="@o.Value">@o.Text</option> }
            }
        </select>
        <span asp-validation-for="BStatus" class="text-danger"></span>
    </div>
</div>
<div class="mb-3 row">
    <label class="col-md-2 col-form-label text-md-end">备注</label>
    <div class="col-md-8">
        <textarea asp-for="Remark" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Remark" class="text-danger"></span>
    </div>
</div>
