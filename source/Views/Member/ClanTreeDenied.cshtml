@{
    ViewData["Title"] = "无法查看族谱";
}
<div class="card mx-auto" style="max-width:28rem;">
    <div class="card-header"><h5 class="mb-0">族谱一览</h5></div>
    <div class="card-body">
        <div class="alert alert-warning mb-3">仅<strong>已认证</strong>的族人可查看本页族谱（只读）。</div>
        <p class="text-muted small">请先完成族员认证，再扫码或打开分享链接。</p>
        <div class="d-grid gap-2">
            <a class="btn btn-primary" asp-action="Cert">去申请认证</a>
            <a class="btn btn-outline-secondary" href="javascript:void(0)" onclick="if(history.length>1)history.back();else location.href='@Url.Action("Home")'">返回上一页</a>
            <a class="btn btn-outline-secondary" asp-action="Home">返回我的任务</a>
        </div>
    </div>
</div>
