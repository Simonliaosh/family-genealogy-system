@model FamilyTree.Models.ViewModels.EPositionFormVm
@{
    var dataScopeOptions = ViewBag.DataScopeOptions as List<(string Value, string Text)> ?? new();
    var bStatusOptions = ViewBag.BStatusOptions as List<(string Value, string Text)> ?? new();
}

<input type="hidden" asp-for="DataId" />

<div class="mb-3 row">
    <label class="col-md-2 col-form-label text-md-end">岗位代码</label>
    <div class="col-md-8">
        <input asp-for="PostCode" class="form-control" maxlength="30" />
        <span asp-validation-for="PostCode" class="text-danger"></span>
    </div>
</div>
<div class="mb-3 row">
    <label class="col-md-2 col-form-label text-md-end">岗位中文名</label>
    <div class="col-md-8">
        <input asp-for="PostCName" class="form-control" maxlength="100" />
        <span asp-validation-for="PostCName" class="text-danger"></span>
    </div>
</div>
<div class="mb-3 row">
    <label class="col-md-2 col-form-label text-md-end">岗位英文名</label>
    <div class="col-md-8">
        <input asp-for="PostEName" class="form-control" maxlength="100" />
        <span asp-validation-for="PostEName" class="text-danger"></span>
    </div>
</div>
<div class="mb-3 row">
    <label class="col-md-2 col-form-label text-md-end">数据范围</label>
    <div class="col-md-8">
        <select asp-for="DataScope" class="form-select">
            @foreach (var o in dataScopeOptions)
            {
                if (string.Equals(o.Value, Model.DataScope, StringComparison.OrdinalIgnoreCase)) { <option value="@o.Value" selected>@o.Text</option> } else { <option value="@o.Value">@o.Text</option> }
            }
        </select>
        <span asp-validation-for="DataScope" class="text-danger"></span>
    </div>
</div>
<div class="mb-3 row">
    <label class="col-md-2 col-form-label text-md-end">显示顺序</label>
    <div class="col-md-8">
        <input asp-for="DispSeq" type="number" min="0" class="form-control" />
        <span asp-validation-for="DispSeq" class="text-danger"></span>
    </div>
</div>
<div class="mb-3 row">
    <label class="col-md-2 col-form-label text-md-end">状态</label>
    <div class="col-md-8">
        <select asp-for="BStatus" class="form-select">
            @foreach (var o in bStatusOptions)
            {
                if (o.Value == Model.BStatus) { <option value="@o.Value" selected>@o.Text</option> } else { <option value="@o.Value">@o.Text</option> }
            }
        </select>
        <span asp-validation-for="BStatus" class="text-danger"></span>
    </div>
</div>
<div class="mb-3 row">
    <label class="col-md-2 col-form-label text-md-end">描述</label>
    <div class="col-md-8">
        <textarea asp-for="DDescription" class="form-control" rows="4"></textarea>
        <span asp-validation-for="DDescription" class="text-danger"></span>
    </div>
</div>
<div class="mb-3 row">
    <label class="col-md-2 col-form-label text-md-end">备注</label>
    <div class="col-md-8">
        <textarea asp-for="Remark" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Remark" class="text-danger"></span>
    </div>
</div>
