@model IReadOnlyList<FamilyTree.Models.ViewModels.FtPersonListRowVm>
@{
    ViewData["Title"] = "人物档案";
    var canCr = ViewBag.CanCreate == true;
    var canDel = ViewBag.CanDelete == true;
    var inMain1 = (string?)ViewBag.InMain1 ?? "";
    var certified1 = (string?)ViewBag.Certified1 ?? "";
    var searchField = (string?)ViewBag.SearchField ?? "FullName";
    var searchContent = (string?)ViewBag.SearchContent ?? "";
    var intPage = (int)(ViewBag.IntPage ?? 1);
    var pageShowNum = (int)(ViewBag.PageShowNum ?? 16);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalRecords = (int)(ViewBag.TotalRecords ?? 0);
    var selectField = (string?)ViewBag.SelectField ?? "FullName";
    var selectFieldArrow = (string?)ViewBag.SelectFieldArrow ?? "0";
    string A(string f, string d) => selectField == f && selectFieldArrow == d ? "text-dark" : "text-secondary";
    var polistPr = PolistReturnToken.Encode(new Dictionary<string, string?>
    {
        ["intPage"] = intPage.ToString(), ["pageShowNum"] = pageShowNum.ToString(),
        ["selectField"] = selectField, ["selectFieldArrow"] = selectFieldArrow,
        ["searchField"] = searchField, ["searchContent"] = searchContent, ["inMain1"] = inMain1, ["certified1"] = certified1
    });
}
<div class="card polist-wrap">
    <div class="card-header"><h5 class="mb-0">人物档案</h5></div>
    <div class="card-body py-2">
        <form id="f-main" asp-action="Index" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="selectField" id="sf" value="@selectField" />
            <input type="hidden" name="selectFieldArrow" id="sa" value="@selectFieldArrow" />
            <div class="polist-filter pm-filter-grid mb-2">
                <div class="d-flex align-items-center gap-1">
                    <label class="polist-filter-lbl mb-0">范围</label>
                    <select name="inMain1" class="form-select form-select-sm" onchange="this.form.submit()">
                        @if (inMain1 == "") { <option value="" selected>全部</option> } else { <option value="">全部</option> }
                        @if (inMain1 == "1") { <option value="1" selected>主谱</option> } else { <option value="1">主谱</option> }
                        @if (inMain1 == "0") { <option value="0" selected>个人小树</option> } else { <option value="0">个人小树</option> }
                    </select>
                </div>
                <div class="d-flex align-items-center gap-1">
                    <label class="polist-filter-lbl mb-0">认证</label>
                    <select name="certified1" class="form-select form-select-sm" onchange="this.form.submit()">
                        @if (certified1 == "") { <option value="" selected>全部</option> } else { <option value="">全部</option> }
                        @if (certified1 == "1") { <option value="1" selected>已认证</option> } else { <option value="1">已认证</option> }
                        @if (certified1 == "0") { <option value="0" selected>未认证</option> } else { <option value="0">未认证</option> }
                    </select>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-polist table-sm">
                    <thead>
                    <tr>
                        <th><span class="d-inline-flex">姓名<span class="polist-sort-stack"><a class="@A("FullName","0") text-decoration-none" href="javascript:doSort('FullName','0');">▲</a><a class="@A("FullName","1") text-decoration-none" href="javascript:doSort('FullName','1');">▼</a></span></span></th>
                        <th>出生年月</th><th>状态</th><th>认证</th><th>世代</th><th>范围</th><th>父亲</th><th>母亲</th>
                        <th class="text-end">@if (canCr) { <a class="btn btn-sm btn-outline-primary" asp-action="Create">添加</a> }</th>
                        @if (canDel) { <th></th> }
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var x in Model)
                    {
                        <tr>
                            <td><a asp-action="Edit" asp-route-id="@x.DataId" asp-route-polistRt="@polistPr">@x.FullName</a></td>
                            <td>@x.BirthDate</td><td>@x.LifeText</td><td>@x.CertText</td><td>@x.GenerationText</td><td>@x.InMainText</td>
                            <td>@x.FatherName</td><td>@x.MotherName</td>
                            <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@x.DataId" asp-route-polistRt="@polistPr">详情</a></td>
                            @if (canDel) { <td><button type="submit" formaction="@Url.Action("Delete")" name="id" value="@x.DataId" class="btn btn-sm btn-outline-danger" onclick="return confirm('确定删除？');">删除</button></td> }
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="mt-2 d-flex align-items-center justify-content-center flex-wrap pm-pager" style="column-gap:.25rem;row-gap:.35rem;font-size:.88rem;">
                <div class="pm-pager-group">
                    <select name="searchField" class="form-select form-select-sm" style="width:12ch;font-size:.8rem;min-height:calc(1.8125rem + 2px);">
                        @if (searchField == "FullName") { <option value="FullName" selected>姓名</option> } else { <option value="FullName">姓名</option> }
                        @if (searchField == "FatherName") { <option value="FatherName" selected>父亲</option> } else { <option value="FatherName">父亲</option> }
                    </select>
                    <span>包含内容</span>
                    <input name="searchContent" value="@searchContent" class="form-control form-control-sm" style="width:12ch;font-size:.8rem;padding:0 .25rem;" />
                    <button type="submit" class="btn btn-sm btn-outline-primary" style="font-size:.88rem;padding:.08rem .4rem;" onclick="setPage(1);">查询</button>
                </div>
                <div class="pm-pager-group">
                    <span>第 @(intPage) 页/总 @(totalPages) 页 总 @(totalRecords) 条</span>
                    <button type="submit" class="btn btn-sm btn-outline-secondary pm-pager-btn" style="font-size:.88rem;padding:.08rem .4rem;" onclick="setPage(1);" @(intPage<=1?"disabled":null)>首页</button>
                    <button type="submit" class="btn btn-sm btn-outline-secondary pm-pager-btn" style="font-size:.88rem;padding:.08rem .4rem;" onclick="setPage(@(intPage-1));" @(intPage<=1?"disabled":null)>上页</button>
                    <button type="submit" class="btn btn-sm btn-outline-secondary pm-pager-btn" style="font-size:.88rem;padding:.08rem .4rem;" onclick="setPage(@(intPage+1));" @(intPage>=totalPages?"disabled":null)>下页</button>
                    <button type="submit" class="btn btn-sm btn-outline-secondary pm-pager-btn" style="font-size:.88rem;padding:.08rem .4rem;" onclick="setPage(@(totalPages));" @(intPage>=totalPages?"disabled":null)>尾页</button>
                </div>
                <div class="pm-pager-group">
                    <span>每页显示</span>
                    <input name="pageShowNum" value="@(pageShowNum)" class="form-control form-control-sm" style="width:4ch;height:1.2rem;font-size:.8rem;padding:0 .2rem;" />
                    <span>条</span>
                    <span>转到第</span>
                    <input name="intPage" id="intPageInput" value="@(intPage)" class="form-control form-control-sm" style="width:4ch;height:1.2rem;font-size:.8rem;padding:0 .2rem;" />
                    <span>页</span>
                    <button type="submit" class="btn btn-sm btn-primary" style="font-size:.88rem;padding:.08rem .4rem;">Go</button>
                </div>
            </div>
        </form>
    </div>
</div>
<script>
    function setPage(p){document.getElementById('intPageInput').value=p;}
    function doSort(f,a){document.getElementById('sf').value=f;document.getElementById('sa').value=a;document.getElementById('f-main').submit();}
</script>
