@model FamilyTree.Models.ViewModels.EEventInstanceDetailVm
@{
    ViewData["Title"] = "事件实例详情";
}

<div class="card">
    <div class="card-header d-flex justify-content-between">
        <h5 class="mb-0">实例 #@Model.DataId</h5>
        <a class="btn btn-sm btn-outline-secondary" asp-action="Index">返回</a>
    </div>
    <div class="card-body pm-form-wrap">
        <div class="mb-2 row"><div class="col-md-3 text-md-end text-secondary">事件</div><div class="col-md-8">@Model.AppCode.@Model.EventCode @(string.IsNullOrWhiteSpace(Model.EventName)?"":"- "+Model.EventName)</div></div>
        <div class="mb-2 row"><div class="col-md-3 text-md-end text-secondary">状态</div><div class="col-md-8">@Model.EventStatus</div></div>
        <div class="mb-2 row"><div class="col-md-3 text-md-end text-secondary">业务对象</div><div class="col-md-8">@Model.ObjectRefDisplay</div></div>
        <div class="mb-2 row"><div class="col-md-3 text-md-end text-secondary">标题/URL</div><div class="col-md-8">@(Model.ObjectTitle ?? "-") / @(Model.ObjectUrl ?? "-")</div></div>
        <div class="mb-2 row"><div class="col-md-3 text-md-end text-secondary">触发人</div><div class="col-md-8">@Model.TriggerUserDisplay</div></div>
        <div class="mb-2 row"><div class="col-md-3 text-md-end text-secondary">Payload</div><div class="col-md-8"><pre class="small mb-0">@(Model.PayloadJson ?? "-")</pre></div></div>
        <div class="mb-2 row"><div class="col-md-3 text-md-end text-secondary">幂等键</div><div class="col-md-8">@(Model.IdempotencyKey ?? "-")</div></div>
        <div class="mb-2 row"><div class="col-md-3 text-md-end text-secondary">统计</div><div class="col-md-8">接收人 @Model.ReceiverCount · 待办 @Model.TodoCount · 日志 @Model.LogCount</div></div>
        @if (!string.IsNullOrWhiteSpace(Model.LastError))
        {
            <div class="mb-2 row"><div class="col-md-3 text-md-end text-danger">错误</div><div class="col-md-8 text-danger">@Model.LastError</div></div>
        }
        <h6 class="mt-3">接收人</h6>
        <table class="table table-sm table-bordered">
            <thead><tr><th>用户</th><th>解析类型</th><th>说明</th></tr></thead>
            <tbody>
            @foreach (var r in Model.Receivers) { <tr><td>@r.UserDisplay</td><td>@r.ResolveType</td><td>@(r.ResolveReason ?? "-")</td></tr> }
            </tbody>
        </table>
        <h6 class="mt-3">最近日志</h6>
        <table class="table table-sm table-bordered">
            <thead><tr><th>时间</th><th>动作</th><th>结果</th><th>备注</th></tr></thead>
            <tbody>
            @foreach (var l in Model.RecentLogs)
            {
                <tr>
                    <td>@l.CreateTime.ToString("HH:mm:ss")</td><td>@l.ActionType</td><td>@l.HandleResult</td><td>@(l.Remark ?? "-")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
