@model IReadOnlyList<FamilyTree.Models.ViewModels.EEventFlowRuleListRowVm>
@{
    ViewData["Title"] = "事件流转规则";
    var canCr = ViewBag.CanCreate == true;
    var canUp = ViewBag.CanUpdate == true;
    var canDel = ViewBag.CanDelete == true;
    var bStatus1 = (string?)ViewBag.BStatus1 ?? "";
    var searchField = (string?)ViewBag.SearchField ?? "RuleCode";
    var searchContent = (string?)ViewBag.SearchContent ?? "";
    var intPage = (int)(ViewBag.IntPage ?? 1);
    var pageShowNum = (int)(ViewBag.PageShowNum ?? 16);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalRecords = (int)(ViewBag.TotalRecords ?? 0);
    var selectField = (string?)ViewBag.SelectField ?? "-";
    var selectFieldArrow = (string?)ViewBag.SelectFieldArrow ?? "0";
    var bStatusOptions = ViewBag.BStatusOptions as List<(string Value, string Text)> ?? new();
    string A(string f, string d) => selectField == f && selectFieldArrow == d ? "text-dark" : "text-secondary";
    var polistPr = PolistReturnToken.Encode(new Dictionary<string, string?>
    {
        ["intPage"] = intPage.ToString(),
        ["pageShowNum"] = pageShowNum.ToString(),
        ["selectField"] = selectField,
        ["selectFieldArrow"] = selectFieldArrow,
        ["searchField"] = searchField,
        ["searchContent"] = searchContent,
        ["bStatus1"] = bStatus1,
    });
}

<div class="card polist-wrap">
    <div class="card-header"><h5 class="mb-0">事件流转规则</h5></div>
    <div class="card-body py-2">
        <form id="f-main" asp-action="Index" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="selectField" id="sf" value="@selectField" />
            <input type="hidden" name="selectFieldArrow" id="sa" value="@selectFieldArrow" />
            <div class="polist-filter pm-filter-grid mb-2">
                <div class="d-flex align-items-center gap-1">
                    <label class="polist-filter-lbl mb-0">状态</label>
                    <select name="bStatus1" class="form-select form-select-sm" onchange="this.form.submit()">
                        @foreach (var o in bStatusOptions)
                        {
                            if (o.Value == bStatus1) { <option value="@o.Value" selected>@o.Text</option> } else { <option value="@o.Value">@o.Text</option> }
                        }
                    </select>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-polist table-sm align-middle">
                    <thead>
                    <tr>
                        <th class="text-center"><span class="d-inline-flex align-items-center">规则编码<span class="polist-sort-stack"><a class="@A("RuleCode","0") text-decoration-none" href="javascript:doSort('RuleCode','0');">▲</a><a class="@A("RuleCode","1") text-decoration-none" href="javascript:doSort('RuleCode','1');">▼</a></span></span></th>
                        <th class="text-center">规则名称</th>
                        <th class="text-center">应用</th>
                        <th class="text-center"><span class="d-inline-flex align-items-center">当前事件<span class="polist-sort-stack"><a class="@A("CurrentEvent","0") text-decoration-none" href="javascript:doSort('CurrentEvent','0');">▲</a><a class="@A("CurrentEvent","1") text-decoration-none" href="javascript:doSort('CurrentEvent','1');">▼</a></span></span></th>
                        <th class="text-center"><span class="d-inline-flex align-items-center">下一事件<span class="polist-sort-stack"><a class="@A("NextEvent","0") text-decoration-none" href="javascript:doSort('NextEvent','0');">▲</a><a class="@A("NextEvent","1") text-decoration-none" href="javascript:doSort('NextEvent','1');">▼</a></span></span></th>
                        <th class="text-center">动作</th>
                        <th class="text-center">条件</th>
                        <th class="text-center">目标</th>
                        <th class="text-center pm-sticky-col pm-col-detail">
                            @if (canCr) { <a class="btn btn-sm btn-outline-primary pm-mini-btn" asp-action="Create">添加</a> }
                        </th>
                        <th class="text-center pm-sticky-col pm-col-del">
                            @if (canDel)
                            {
                                <button type="submit" formaction="@Url.Action("BatchDelete")" class="btn btn-sm btn-outline-danger pm-mini-btn" onclick="return confirm('确定要删除吗？\n注意：删除后不能恢复！');">删除</button>
                            }
                        </th>
                        <th class="text-center pm-sticky-col pm-col-sel">
                            @if (canDel)
                            {
                                <input type="checkbox" id="chk-all-fn" class="align-middle pm-row-chk" />
                            }
                        </th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var x in Model)
                    {
                        <tr>
                            <td class="text-start">@x.RuleCodeDisplay</td>
                            <td class="text-start">@x.RuleNameDisplay</td>
                            <td class="text-center">@x.AppCode</td>
                            <td class="text-start">@x.CurrentEventDisplay</td>
                            <td class="text-start">@x.NextEventDisplay</td>
                            <td class="text-center">@x.ActionTypeText</td>
                            <td class="text-start">@x.ConditionSummary</td>
                            <td class="text-start">@x.TargetSummary</td>
                            <td class="text-center pm-sticky-col pm-col-detail">
                                @if (canUp) { <a class="btn btn-sm btn-outline-primary pm-mini-btn" asp-action="Edit" asp-route-id="@x.DataId" asp-route-polistRt="@polistPr">详情</a> }
                            </td>
                            <td class="text-center pm-sticky-col pm-col-del">
                                @if (canDel)
                                {
                                    <button type="submit" formaction="@Url.Action("Delete")" name="id" value="@x.DataId" class="btn btn-sm btn-outline-danger pm-mini-btn" onclick="return confirm('确定要删除吗？\n注意：删除后不能恢复！');">删除</button>
                                }
                            </td>
                            <td class="text-center pm-sticky-col pm-col-sel">
                                @if (canDel)
                                {
                                    <input type="checkbox" name="ids" value="@x.DataId" class="fn-row-chk align-middle pm-row-chk" />
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <div class="polist-bottom"></div>
            <div class="mt-2 d-flex align-items-center justify-content-center flex-wrap pm-pager" style="column-gap:.25rem;row-gap:.35rem;font-size:.88rem;">
                <div class="pm-pager-group">
                    <select name="searchField" class="form-select form-select-sm" style="width:16ch;font-size:.8rem;min-height:calc(1.8125rem + 2px);">
                        @if (searchField == "RuleCode") { <option value="RuleCode" selected>规则编码</option> } else { <option value="RuleCode">规则编码</option> }
                        @if (searchField == "RuleName") { <option value="RuleName" selected>规则名称</option> } else { <option value="RuleName">规则名称</option> }
                        @if (searchField == "AppCode") { <option value="AppCode" selected>应用</option> } else { <option value="AppCode">应用</option> }
                        @if (searchField == "CurrentEvent") { <option value="CurrentEvent" selected>当前事件</option> } else { <option value="CurrentEvent">当前事件</option> }
                        @if (searchField == "NextEvent") { <option value="NextEvent" selected>下一事件</option> } else { <option value="NextEvent">下一事件</option> }
                        @if (searchField == "ConditionExpr") { <option value="ConditionExpr" selected>条件表达式</option> } else { <option value="ConditionExpr">条件表达式</option> }
                    </select>
                    <span>包含内容</span>
                    <input name="searchContent" value="@searchContent" class="form-control form-control-sm" style="width:12ch;font-size:.8rem;padding:0 .25rem;" />
                    <button type="submit" class="btn btn-sm btn-outline-primary" style="font-size:.88rem;padding:.08rem .4rem;" onclick="setPage(1);">查询</button>
                </div>
                <div class="pm-pager-group">
                    <span>第 @(intPage) 页/总 @(totalPages) 页 总 @(totalRecords) 条</span>
                    <button type="submit" class="btn btn-sm btn-outline-secondary pm-pager-btn" style="font-size:.88rem;padding:.08rem .4rem;" onclick="setPage(1);" @(intPage<=1?"disabled":null)>首页</button>
                    <button type="submit" class="btn btn-sm btn-outline-secondary pm-pager-btn" style="font-size:.88rem;padding:.08rem .4rem;" onclick="setPage(@(intPage-1));" @(intPage<=1?"disabled":null)>上页</button>
                    <button type="submit" class="btn btn-sm btn-outline-secondary pm-pager-btn" style="font-size:.88rem;padding:.08rem .4rem;" onclick="setPage(@(intPage+1));" @(intPage>=totalPages?"disabled":null)>下页</button>
                    <button type="submit" class="btn btn-sm btn-outline-secondary pm-pager-btn" style="font-size:.88rem;padding:.08rem .4rem;" onclick="setPage(@(totalPages));" @(intPage>=totalPages?"disabled":null)>尾页</button>
                </div>
                <div class="pm-pager-group">
                    <span>每页显示</span>
                    <input name="pageShowNum" value="@(pageShowNum)" class="form-control form-control-sm" style="width:4ch;height:1.2rem;font-size:.8rem;padding:0 .2rem;" />
                    <span>条</span>
                    <span>转到第</span>
                    <input name="intPage" id="intPageInput" value="@(intPage)" class="form-control form-control-sm" style="width:4ch;height:1.2rem;font-size:.8rem;padding:0 .2rem;" />
                    <span>页</span>
                    <button type="submit" class="btn btn-sm btn-primary" style="font-size:.88rem;padding:.08rem .4rem;">Go</button>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    function setPage(p){document.getElementById('intPageInput').value=p;}
    function doSort(f,a){document.getElementById('sf').value=f;document.getElementById('sa').value=a;document.getElementById('f-main').submit();}
    document.getElementById('chk-all-fn')?.addEventListener('change',function(){document.querySelectorAll('.fn-row-chk').forEach(c=>c.checked=this.checked);});
</script>

<style>
    .pm-sticky-col{position:sticky;background:#fff;z-index:4;}
    thead .pm-sticky-col{background:#f8f9fa;z-index:5;}
    tbody .pm-sticky-col{z-index:4;}
    .pm-col-sel{right:0;min-width:1.55rem;width:1.55rem;}
    .pm-col-del{right:1.55rem;min-width:2.42rem;width:2.42rem;}
    .pm-col-detail{right:3.97rem;min-width:2.72rem;width:2.72rem;}
    .pm-mini-btn{
        font-size:.68rem!important;
        padding-top:.02rem!important;
        padding-bottom:.02rem!important;
        padding-left:0!important;
        padding-right:0!important;
        line-height:1.05;
        white-space:nowrap!important;
        display:flex;
        align-items:center;
        justify-content:center;
        min-height:1.06rem!important;
        height:1.06rem;
        width:100%;
    }
    .pm-row-chk{margin:0;transform:scale(.82);}
    @@media (max-width:576px){
        .pm-col-sel{min-width:1.45rem;width:1.45rem;}
        .pm-col-del{right:1.45rem;min-width:2.22rem;width:2.22rem;}
        .pm-col-detail{right:3.67rem;min-width:2.48rem;width:2.48rem;}
        .pm-mini-btn{font-size:.64rem!important;min-height:1rem!important;height:1rem;}
    }
</style>
