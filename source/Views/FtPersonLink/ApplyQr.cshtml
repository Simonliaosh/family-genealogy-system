@model FamilyTree.Models.ViewModels.FtLinkScanVm
@{
    ViewData["Title"] = "链入申请二维码";
    var scanUrl = (string?)ViewBag.ScanUrl ?? "";
}
<div class="card mx-auto" style="max-width:36rem;">
    <div class="card-header"><h5 class="mb-0">链入申请二维码</h5></div>
    <div class="card-body text-center">
        <p class="mb-2">请把下面二维码发给<strong>分支管理员或超管</strong>，对方扫码后可直接审批。</p>
        <p class="small text-muted mb-3">@Model.SourceName → @Model.TargetName · @(Model.LinkStatus == "PENDING" ? "待审" : Model.LinkStatus)</p>
        @if (Model.LinkStatus == "PENDING")
        {
            <img src="@Url.Action("ApplyQrImg", new { id = Model.LinkId })" alt="链入审批二维码" class="border rounded mb-3" style="width:220px;height:220px;" />
            <p class="small text-break text-muted">@scanUrl</p>
        }
        else
        {
            <div class="alert alert-info">该申请当前状态：@Model.LinkStatus（无需再扫码）。</div>
        }
        <div class="mt-3 d-flex flex-wrap gap-2 justify-content-center">
            <a class="btn btn-outline-secondary" asp-action="Index">我的申请列表</a>
            <a class="btn btn-outline-primary" asp-controller="FtPerson" asp-action="Edit" asp-route-id="@Model.SourceId">查看源人物</a>
        </div>
    </div>
</div>
