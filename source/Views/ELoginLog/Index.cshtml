@model IReadOnlyList<FamilyTree.Models.ViewModels.ELoginLogListRowVm>
@{
    ViewData["Title"] = "登录日志";
    var loginStatus1 = (string?)ViewBag.LoginStatus1 ?? "";
    var loginIdFilter = (string?)ViewBag.LoginIdFilter ?? "";
    var loginTimeFrom = (string?)ViewBag.LoginTimeFrom ?? "";
    var loginTimeTo = (string?)ViewBag.LoginTimeTo ?? "";
    var searchField = (string?)ViewBag.SearchField ?? "LoginId";
    var searchContent = (string?)ViewBag.SearchContent ?? "";
    var intPage = (int)(ViewBag.IntPage ?? 1);
    var pageShowNum = (int)(ViewBag.PageShowNum ?? 16);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalRecords = (int)(ViewBag.TotalRecords ?? 0);
    var selectField = (string?)ViewBag.SelectField ?? "-";
    var selectFieldArrow = (string?)ViewBag.SelectFieldArrow ?? "0";
    var loginStatusOptions = ViewBag.LoginStatusOptions as List<(string Value, string Text)> ?? new();
    var rangeNote = (string?)ViewBag.RangeNote ?? "";
    var canExport = ViewBag.CanExport == true;
    string A(string f, string d) => selectField == f && selectFieldArrow == d ? "text-dark" : "text-secondary";
}

<div class="card polist-wrap">
    <div class="card-header"><h5 class="mb-0">登录日志</h5></div>
    <div class="card-body py-2">
        @if (!string.IsNullOrWhiteSpace(rangeNote))
        {
            <p class="small text-muted mb-2">@rangeNote</p>
        }
        <form id="f-main" asp-action="Index" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="selectField" id="sf" value="@selectField" />
            <input type="hidden" name="selectFieldArrow" id="sa" value="@selectFieldArrow" />
            <div class="polist-filter pm-filter-grid mb-2">
                <div class="d-flex align-items-center gap-1">
                    <label class="polist-filter-lbl mb-0">登录状态</label>
                    <select name="loginStatus1" class="form-select form-select-sm" onchange="this.form.submit()">
                        @foreach (var o in loginStatusOptions)
                        {
                            if (o.Value == loginStatus1) { <option value="@o.Value" selected>@o.Text</option> } else { <option value="@o.Value">@o.Text</option> }
                        }
                    </select>
                </div>
                <div class="d-flex align-items-center gap-1">
                    <label class="polist-filter-lbl mb-0">登录时间起</label>
                    <input type="date" name="loginTimeFrom" value="@loginTimeFrom" class="form-control form-control-sm" onchange="this.form.submit()" />
                </div>
                <div class="d-flex align-items-center gap-1">
                    <label class="polist-filter-lbl mb-0">登录时间止</label>
                    <input type="date" name="loginTimeTo" value="@loginTimeTo" class="form-control form-control-sm" onchange="this.form.submit()" />
                </div>
                <div class="d-flex align-items-center gap-1">
                    <label class="polist-filter-lbl mb-0">登录账号</label>
                    <input type="text" name="loginIdFilter" value="@loginIdFilter" class="form-control form-control-sm" placeholder="模糊" onchange="this.form.submit()" />
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mb-2 justify-content-end">
                @if (canExport)
                {
                    <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Export", new { loginStatus1, loginIdFilter, loginTimeFrom, loginTimeTo, searchField, searchContent })">导出CSV</a>
                }
            </div>

            <div class="table-responsive">
                <table class="table table-polist table-sm align-middle">
                    <thead>
                    <tr>
                        <th class="text-center"><span class="d-inline-flex align-items-center">登录时间<span class="polist-sort-stack"><a class="@A("LoginTime","0") text-decoration-none" href="javascript:doSort('LoginTime','0');">▲</a><a class="@A("LoginTime","1") text-decoration-none" href="javascript:doSort('LoginTime','1');">▼</a></span></span></th>
                        <th class="text-center"><span class="d-inline-flex align-items-center">登录账号<span class="polist-sort-stack"><a class="@A("LoginId","0") text-decoration-none" href="javascript:doSort('LoginId','0');">▲</a><a class="@A("LoginId","1") text-decoration-none" href="javascript:doSort('LoginId','1');">▼</a></span></span></th>
                        <th class="text-center"><span class="d-inline-flex align-items-center">状态<span class="polist-sort-stack"><a class="@A("LoginStatus","0") text-decoration-none" href="javascript:doSort('LoginStatus','0');">▲</a><a class="@A("LoginStatus","1") text-decoration-none" href="javascript:doSort('LoginStatus','1');">▼</a></span></span></th>
                        <th class="text-center">失败原因</th>
                        <th class="text-center">IP</th>
                        <th class="text-center">用户</th>
                        <th class="text-end pm-sticky-col pm-col-detail pm-op-col"></th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var x in Model)
                    {
                        <tr>
                            <td class="text-center">@x.LoginTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td class="text-center">@x.LoginId</td>
                            <td class="text-center">@x.LoginStatusText</td>
                            <td class="text-center">@x.FailReasonDisplay</td>
                            <td class="text-center">@x.IpDisplay</td>
                            <td class="text-center">@x.UserDisplay</td>
                            <td class="text-end pm-sticky-col pm-col-detail pm-op-col">
                                <a class="btn btn-sm btn-outline-primary pm-op-btn" asp-action="Details" asp-route-id="@x.DataId">详情</a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <div class="polist-bottom"></div>
            <div class="mt-2 d-flex align-items-center justify-content-center flex-wrap pm-pager" style="column-gap:.25rem;row-gap:.35rem;font-size:.88rem;">
                <div class="pm-pager-group">
                    <select name="searchField" class="form-select form-select-sm" style="width:16ch;font-size:.8rem;min-height:calc(1.8125rem + 2px);">
                        @if (searchField == "LoginId") { <option value="LoginId" selected>登录账号</option> } else { <option value="LoginId">登录账号</option> }
                        @if (searchField == "IPAddress") { <option value="IPAddress" selected>IP</option> } else { <option value="IPAddress">IP</option> }
                        @if (searchField == "FailReason") { <option value="FailReason" selected>失败原因</option> } else { <option value="FailReason">失败原因</option> }
                        @if (searchField == "UserID") { <option value="UserID" selected>用户ID</option> } else { <option value="UserID">用户ID</option> }
                    </select>
                    <span>包含内容</span>
                    <input name="searchContent" value="@searchContent" class="form-control form-control-sm" style="width:12ch;font-size:.8rem;padding:0 .25rem;" />
                    <button type="submit" class="btn btn-sm btn-outline-primary" style="font-size:.88rem;padding:.08rem .4rem;" onclick="setPage(1);">查询</button>
                </div>
                <div class="pm-pager-group">
                    <span>第 @(intPage) 页/总 @(totalPages) 页 总 @(totalRecords) 条</span>
                    <button type="submit" class="btn btn-sm btn-outline-secondary pm-pager-btn" style="font-size:.88rem;padding:.08rem .4rem;" onclick="setPage(1);" @(intPage<=1?"disabled":null)>首页</button>
                    <button type="submit" class="btn btn-sm btn-outline-secondary pm-pager-btn" style="font-size:.88rem;padding:.08rem .4rem;" onclick="setPage(@(intPage-1));" @(intPage<=1?"disabled":null)>上页</button>
                    <button type="submit" class="btn btn-sm btn-outline-secondary pm-pager-btn" style="font-size:.88rem;padding:.08rem .4rem;" onclick="setPage(@(intPage+1));" @(intPage>=totalPages?"disabled":null)>下页</button>
                    <button type="submit" class="btn btn-sm btn-outline-secondary pm-pager-btn" style="font-size:.88rem;padding:.08rem .4rem;" onclick="setPage(@(totalPages));" @(intPage>=totalPages?"disabled":null)>尾页</button>
                </div>
                <div class="pm-pager-group">
                    <span>每页显示</span>
                    <input name="pageShowNum" value="@(pageShowNum)" class="form-control form-control-sm" style="width:4ch;height:1.2rem;font-size:.8rem;padding:0 .2rem;" />
                    <span>条</span>
                    <span>转到第</span>
                    <input name="intPage" id="intPageInput" value="@(intPage)" class="form-control form-control-sm" style="width:4ch;height:1.2rem;font-size:.8rem;padding:0 .2rem;" />
                    <span>页</span>
                    <button type="submit" class="btn btn-sm btn-primary" style="font-size:.88rem;padding:.08rem .4rem;">Go</button>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    function setPage(p){document.getElementById('intPageInput').value=p;}
    function doSort(f,a){document.getElementById('sf').value=f;document.getElementById('sa').value=a;document.getElementById('f-main').submit();}
</script>

<style>
    .pm-sticky-col{position:sticky;background:#fff;z-index:4;}
    thead .pm-sticky-col{background:#f8f9fa;z-index:5;}
    .pm-op-col{padding-left:.2rem!important;padding-right:.2rem!important;white-space:nowrap;text-align:right!important;}
    .pm-col-detail{right:0;width:2.9rem;min-width:2.9rem;}
    .pm-op-btn{font-size:.72rem!important;line-height:1.15!important;padding:.05rem .2rem!important;min-height:1.2rem;height:1.2rem;display:inline-flex;align-items:center;justify-content:center;}
</style>
