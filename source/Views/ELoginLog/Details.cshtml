@model FamilyTree.Models.ViewModels.ELoginLogDetailVm
@{
    ViewData["Title"] = "登录日志详情";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">登录日志详情</h5>
        <a class="btn btn-sm btn-outline-secondary" asp-action="Index">返回列表</a>
    </div>
    <div class="card-body pm-form-wrap">
        <div class="mb-2 row">
            <div class="col-md-3 text-md-end text-secondary">DataID</div>
            <div class="col-md-8">@Model.DataId</div>
        </div>
        <div class="mb-2 row">
            <div class="col-md-3 text-md-end text-secondary">登录时间</div>
            <div class="col-md-8">@Model.LoginTime.ToString("yyyy-MM-dd HH:mm:ss")</div>
        </div>
        <div class="mb-2 row">
            <div class="col-md-3 text-md-end text-secondary">登录账号</div>
            <div class="col-md-8">@Model.LoginId</div>
        </div>
        <div class="mb-2 row">
            <div class="col-md-3 text-md-end text-secondary">用户</div>
            <div class="col-md-8">@Model.UserDisplay @if (Model.UserId.HasValue) { <span class="text-muted">(UserID=@Model.UserId)</span> }</div>
        </div>
        <div class="mb-2 row">
            <div class="col-md-3 text-md-end text-secondary">状态</div>
            <div class="col-md-8">@Model.LoginStatusText <code class="small">@Model.LoginStatus</code></div>
        </div>
        <div class="mb-2 row">
            <div class="col-md-3 text-md-end text-secondary">失败原因</div>
            <div class="col-md-8">@(string.IsNullOrWhiteSpace(Model.FailReason) ? "-" : Model.FailReason)</div>
        </div>
        <div class="mb-2 row">
            <div class="col-md-3 text-md-end text-secondary">IP</div>
            <div class="col-md-8">@(string.IsNullOrWhiteSpace(Model.IPAddress) ? "-" : Model.IPAddress)</div>
        </div>
    </div>
</div>
