@model FamilyTree.Models.ViewModels.FtDraftFormVm
@{ ViewData["Title"] = "录入人物"; var polistRt = ViewBag.PolistRt as string; var canComplete = ViewBag.CanComplete == true; }
<div class="card"><div class="card-header"><h5 class="mb-0">录入人物</h5></div>
<div class="card-body pm-form-wrap">
<form asp-action="Edit" asp-route-id="@Model.DataId" method="post">@Html.AntiForgeryToken()
<input type="hidden" name="polistRt" value="@polistRt" />
@await Html.PartialAsync("_Form", Model)
<div class="row mt-2"><div class="col-md-10 offset-md-2 d-flex justify-content-center gap-2 flex-wrap">
@if (canComplete) {
<button type="submit" name="selectNo" value="1" class="btn btn-primary">保存/继续</button>
<button type="submit" name="selectNo" value="0" class="btn btn-primary">保存/退出</button>
}
<button type="submit" name="selectNo" value="9" class="btn btn-secondary">关闭</button>
</div></div></form>
@if (canComplete) {
<form asp-action="Complete" method="post" class="mt-3 text-center">@Html.AntiForgeryToken()
<input type="hidden" name="id" value="@Model.DataId" />
<button class="btn btn-success" type="submit">完成并入档</button>
</form>
}
</div></div>
