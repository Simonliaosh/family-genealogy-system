@model FamilyTree.Models.ViewModels.FtLinkScanVm?
@{
    ViewData["Title"] = "扫码审链入";
    var can = ViewBag.CanApprove == true;
    var err = ViewBag.Err as string;
    string Dash(string? s) => string.IsNullOrWhiteSpace(s) ? "—" : s;
}
<div class="card mx-auto" style="max-width:40rem;">
    <div class="card-header"><h5 class="mb-0">链入审批（扫码）</h5></div>
    <div class="card-body">
        @if (!string.IsNullOrEmpty(err))
        {
            <div class="alert alert-warning mb-0">@err</div>
        }
        else if (Model != null)
        {
            <p class="small text-muted mb-2">@Model.LevelLabel · 申请时间 @Model.CreateDate.ToString("yyyy-MM-dd HH:mm")</p>
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <h6>申请人侧（源）</h6>
                    <table class="table table-sm table-bordered mb-0">
                        <tr><th style="width:5rem;">姓名</th><td>@Model.SourceName</td></tr>
                        <tr><th>父母</th><td>@Dash(Model.SourceFather) / @Dash(Model.SourceMother)</td></tr>
                        <tr><th>出生年月</th><td>@Dash(Model.SourceBirth)</td></tr>
                    </table>
                </div>
                <div class="col-md-6">
                    <h6>主谱目标</h6>
                    <table class="table table-sm table-bordered mb-0">
                        <tr><th style="width:5rem;">姓名</th><td>@Model.TargetName</td></tr>
                        <tr><th>父母</th><td>@Dash(Model.TargetFather) / @Dash(Model.TargetMother)</td></tr>
                        <tr><th>出生年月</th><td>@Dash(Model.TargetBirth)</td></tr>
                    </table>
                </div>
            </div>

            @if (Model.LinkStatus == "PENDING")
            {
                if (can)
                {
                    <form asp-action="Approve" method="post" class="d-flex flex-wrap gap-2 align-items-end">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.LinkId" />
                        <div class="flex-grow-1" style="min-width:12rem;">
                            <label class="form-label small mb-0">备注</label>
                            <input name="remark" class="form-control form-control-sm" maxlength="200" />
                        </div>
                        <button type="submit" name="pass" value="true" class="btn btn-success" onclick="return confirm('确认通过链入？通过后将挂入主谱。');">通过</button>
                        <button type="submit" name="pass" value="false" class="btn btn-outline-danger" onclick="return confirm('确认驳回？');">驳回</button>
                    </form>
                }
                else
                {
                    <div class="alert alert-info mb-0">请用<strong>分支管理员或超管</strong>账号登录后再审批。</div>
                }
            }
            else if (Model.LinkStatus == "EFFECTIVE")
            {
                <div class="alert alert-success mb-0">已通过，已挂入主谱。</div>
            }
            else
            {
                <div class="alert alert-secondary mb-0">当前状态：@Model.LinkStatus</div>
            }

            <div class="mt-3">
                <a class="btn btn-sm btn-outline-secondary" asp-action="Index">审批列表</a>
                <a class="btn btn-sm btn-link" asp-controller="FtPerson" asp-action="Edit" asp-route-id="@Model.SourceId">源人物</a>
                <a class="btn btn-sm btn-link" asp-controller="FtPerson" asp-action="Edit" asp-route-id="@Model.TargetId">主谱目标</a>
            </div>
        }
    </div>
</div>
