@model FamilyTree.Models.ViewModels.ETodoTaskDetailVm
@{
    ViewData["Title"] = "待办详情";
    var canUp = ViewBag.CanUpdate == true;
    var deptOpts = ViewBag.HandlerDeptOptions as List<(string Value, string Text)> ?? new();
    var posOpts = ViewBag.HandlerPosOptions as List<(string Value, string Text)> ?? new();
    var err = ViewBag.HandleError as string;
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">待办详情</h5>
        <a class="btn btn-sm btn-outline-secondary" asp-action="Index">返回列表</a>
    </div>
    <div class="card-body pm-form-wrap">
        @if (!string.IsNullOrEmpty(err))
        {
            <div class="alert alert-warning">@err</div>
        }
        @if (TempData["HandleMsg"] is string tm && !string.IsNullOrEmpty(tm))
        {
            <div class="alert alert-success">@tm</div>
        }

        <div class="mb-2 row">
            <div class="col-md-3 text-md-end text-secondary">DataID</div>
            <div class="col-md-8">@Model.DataId</div>
        </div>
        <div class="mb-2 row">
            <div class="col-md-3 text-md-end text-secondary">标题</div>
            <div class="col-md-8">@(string.IsNullOrWhiteSpace(Model.TodoTitle) ? "(无标题)" : Model.TodoTitle)</div>
        </div>
        <div class="mb-2 row">
            <div class="col-md-3 text-md-end text-secondary">归属用户</div>
            <div class="col-md-8">@Model.UserDisplay</div>
        </div>
        <div class="mb-2 row">
            <div class="col-md-3 text-md-end text-secondary">状态</div>
            <div class="col-md-8">@Model.StatusText</div>
        </div>
        <div class="mb-2 row">
            <div class="col-md-3 text-md-end text-secondary">优先级</div>
            <div class="col-md-8">@Model.PriorityText <span class="text-muted small">(@Model.Priority)</span></div>
        </div>
        @if (Model.DueTime.HasValue)
        {
            <div class="mb-2 row">
                <div class="col-md-3 text-md-end text-secondary">截止时间</div>
                <div class="col-md-8">@Model.DueTime.Value.ToString("yyyy-MM-dd HH:mm:ss")</div>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.EventCode))
        {
            <div class="mb-2 row">
                <div class="col-md-3 text-md-end text-secondary">事件编码</div>
                <div class="col-md-8"><code>@Model.EventCode</code></div>
            </div>
        }
        <div class="mb-2 row">
            <div class="col-md-3 text-md-end text-secondary">业务对象</div>
            <div class="col-md-8">
                <div>@Model.ObjectRefDisplay</div>
                <div class="text-muted small">类型 <code>@Model.ObjectType</code> · 键 <code>@Model.ObjectKey</code></div>
                @if (!string.IsNullOrEmpty(Model.BusinessUrl))
                {
                    <div class="mt-1">
                        <a class="btn btn-sm btn-outline-primary" href="@Model.BusinessUrl">@Model.BusinessLinkLabel</a>
                    </div>
                }
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.ObjectTitle))
        {
            <div class="mb-2 row">
                <div class="col-md-3 text-md-end text-secondary">对象标题</div>
                <div class="col-md-8">@Model.ObjectTitle</div>
            </div>
        }
        <div class="mb-2 row">
            <div class="col-md-3 text-md-end text-secondary">事件日志 ID</div>
            <div class="col-md-8">
                @if (Model.EventLogId.HasValue)
                {
                    <a asp-controller="EEventLog" asp-action="Details" asp-route-id="@((long)Model.EventLogId.Value)">@Model.EventLogId（可能与 BIGINT 日志主键不一致，以引擎为准）</a>
                }
                else { <span>-</span> }
            </div>
        </div>
        <div class="mb-2 row">
            <div class="col-md-3 text-md-end text-secondary">处理部门/岗位</div>
            <div class="col-md-8">@(Model.HandlerDeptDisplay ?? "-") / @(Model.HandlerPosDisplay ?? "-")</div>
        </div>
        <div class="mb-2 row">
            <div class="col-md-3 text-md-end text-secondary">创建 / 处理时间</div>
            <div class="col-md-8">@Model.CreateTime.ToString("yyyy-MM-dd HH:mm:ss") / @(Model.HandleTime.HasValue ? Model.HandleTime.Value.ToString("yyyy-MM-dd HH:mm:ss") : "-")</div>
        </div>

        @if (canUp && Model.Status == 0)
        {
            <hr />
            <h6 class="mb-3">处理待办</h6>
            <form asp-action="Handle" method="post" class="mb-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="DataId" value="@Model.DataId" />
                <div class="mb-3 row">
                    <label class="col-md-3 col-form-label text-md-end">目标状态</label>
                    <div class="col-md-8">
                        <select name="NewStatus" class="form-select" required>
                            <option value="1" selected>已处理</option>
                            <option value="2">已关闭</option>
                        </select>
                    </div>
                </div>
                <div class="mb-3 row">
                    <label class="col-md-3 col-form-label text-md-end">处理部门</label>
                    <div class="col-md-8">
                        <select name="HandlerDeptId" class="form-select">
                            @foreach (var o in deptOpts)
                            {
                                <option value="@o.Value">@o.Text</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="mb-3 row">
                    <label class="col-md-3 col-form-label text-md-end">处理岗位</label>
                    <div class="col-md-8">
                        <select name="HandlerPosId" class="form-select">
                            @foreach (var o in posOpts)
                            {
                                <option value="@o.Value">@o.Text</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-8 offset-md-3">
                        <button type="submit" class="btn btn-primary">提交处理</button>
                    </div>
                </div>
            </form>
        }
    </div>
</div>
