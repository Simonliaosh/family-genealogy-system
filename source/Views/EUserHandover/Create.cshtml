@model FamilyTree.Models.ViewModels.EUserHandoverFormVm
@{
    ViewData["Title"] = "用户交接登记";
}

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">用户交接登记</h5>
    </div>
    <div class="card-body pm-form-wrap">
        <p class="small text-muted">交接发生时间与操作人由系统自动记录；首版仅保存记录，不自动变更权限或待办归属。</p>
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            @await Html.PartialAsync("_Form", Model)
            <div class="row mt-2">
                <div class="col-md-10 offset-md-2 d-flex justify-content-center gap-2 flex-wrap">
                    <button type="submit" name="selectNo" value="1" class="btn btn-primary">保存/继续</button>
                    <button type="submit" name="selectNo" value="0" class="btn btn-primary">保存/退出</button>
                    <button type="submit" name="selectNo" value="9" class="btn btn-secondary">关闭</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
