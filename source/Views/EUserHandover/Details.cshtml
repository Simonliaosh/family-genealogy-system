@model FamilyTree.Models.ViewModels.EUserHandoverDetailVm
@{
    ViewData["Title"] = "用户交接详情";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">用户交接详情</h5>
        <a class="btn btn-sm btn-outline-secondary" asp-action="Index">返回列表</a>
    </div>
    <div class="card-body pm-form-wrap">
        <div class="mb-2 row">
            <div class="col-md-3 text-md-end text-secondary">DataID</div>
            <div class="col-md-8">@Model.DataId</div>
        </div>
        <div class="mb-2 row">
            <div class="col-md-3 text-md-end text-secondary">交接时间</div>
            <div class="col-md-8">@Model.HandoverTime.ToString("yyyy-MM-dd HH:mm:ss")</div>
        </div>
        <div class="mb-2 row">
            <div class="col-md-3 text-md-end text-secondary">交出方</div>
            <div class="col-md-8">@Model.SourceDisplay <span class="text-muted">(UserID=@Model.SourceUserId)</span></div>
        </div>
        <div class="mb-2 row">
            <div class="col-md-3 text-md-end text-secondary">接收方</div>
            <div class="col-md-8">@Model.TargetDisplay <span class="text-muted">(UserID=@Model.TargetUserId)</span></div>
        </div>
        <div class="mb-2 row">
            <div class="col-md-3 text-md-end text-secondary">交接类型</div>
            <div class="col-md-8">@Model.HandoverTypeText <code class="small">@Model.HandoverType</code></div>
        </div>
        <div class="mb-2 row">
            <div class="col-md-3 text-md-end text-secondary">操作人</div>
            <div class="col-md-8">@Model.OperatorDisplay <span class="text-muted">(UserID=@Model.OperatorUserId)</span></div>
        </div>
        <div class="mb-2 row">
            <div class="col-md-3 text-md-end text-secondary">备注</div>
            <div class="col-md-8" style="white-space:pre-wrap;">@(string.IsNullOrWhiteSpace(Model.Remark) ? "-" : Model.Remark)</div>
        </div>
    </div>
</div>
